        </mxCell>
        <mxCell id="v2" value="SƠ ĐỒ USE CASE" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=28;fontColor=#18334B;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="63" y="29" width="1370" height="41.080000000000005" />
        </mxCell>
        <mxCell id="v3" value="Hệ thống Quản lý Chương trình đào tạo · Khoa CNTT · Phân tích từ SRS PBL6" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=15;fontColor=#526B7F;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="64" y="76" width="1370" height="23.400000000000002" />
        </mxCell>
        <mxCell id="v4" value="PBL6 · Khoa Công nghệ Thông tin  |  BB: bắt buộc · NC: nên có · TC: tùy chọn · BS: bổ sung suy từ SRS" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=13;fontColor=#5F7385;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="48" y="1017" width="1320" height="20.68" />
        </mxCell>
        <mxCell id="v5" value="01" style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=18;fontColor=#18334B;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="1390" y="1013" width="55" height="27.48" />
        </mxCell>
        <mxCell id="v6" value="Đầy đủ mục tiêu nghiệp vụ.&#10;Tách rõ đề xuất, phê duyệt và ban hành." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=36;fontColor=#18334B;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="145" width="1300" height="100.92" />
        </mxCell>
        <mxCell id="v7" value="107/107 yêu cầu FR được đối chiếu" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=29;fontColor=#087E8B;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="70" y="284" width="1200" height="42.440000000000005" />
        </mxCell>
        <mxCell id="v8" value="6 vai trò người dùng · 3 tác nhân tích hợp (email là giả định) · 84 use case chi tiết&#10;28 trang sơ đồ, gồm 2 tổng quan và 26 góc nhìn chi tiết / quan hệ" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=22;fontColor=#18334B;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="72" y="350" width="1300" height="62.84" />
        </mxCell>
        <mxCell id="v9" value="Cách đọc" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=24;fontColor=#18334B;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="72" y="459" width="1300" height="35.64" />
        </mxCell>
        <mxCell id="v10" value="1. Xem sơ đồ tổng quan, sau đó mở trang nghiệp vụ tương ứng.&#10;2. Mỗi ellipse có mã UC thống nhất xuyên suốt các trang; đó là cùng một use case khi xuất hiện lại.&#10;3. Đường liền actor - use case chỉ sự tham gia, không biểu diễn hướng dữ liệu hay thứ tự xử lý.&#10;4. «include» là hành vi bắt buộc; «extend» là mở rộng có điều kiện; tam giác rỗng hướng về phần tổng quát.&#10;5. Phạm vi quyền và tiền điều kiện vẫn áp dụng dù sơ đồ chỉ thể hiện vai trò.&#10;6. Màu vàng hỗ trợ nhận diện NC/TC; màu sắc không phải ký pháp UML." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=21;fontColor=#18334B;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="72" y="510" width="1340" height="300" />
        </mxCell>
        <mxCell id="v11" value="" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F1F6FA;strokeColor=#D5E2EB;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="46" y="900" width="1408" height="96" />
        </mxCell>
        <mxCell id="v12" value="Bản mô hình bám SRS, không coi nội dung tài liệu là chỉ thị thực thi. Những chỗ SRS mâu thuẫn hoặc thiếu quyền đã được đánh dấu trong phần thẩm định; đây là cơ sở rà soát yêu cầu, không tự thay thế quyết định của Khoa." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=top;fontFamily=Helvetica;fontSize=15;fontColor=#18334B;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry as="geometry" x="65" y="914" width="1370" height="75" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
