  <diagram id="page-1" name="SƠ ĐỒ USE CASE">
    <mxGraphModel dx="1500" dy="1060" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1500" pageHeight="1060" math="0" shadow="0">
      <root>
        <mxCell id="0" />
