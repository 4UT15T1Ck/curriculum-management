        <mxCell id="v14" value="HÀNH VI HỖ TRỢ&#10;Không có actor trực tiếp.&#10;Xem quan hệ «include»&#10;ở các trang 23-24." style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=top;fontFamily=Helvetica;fontSize=18;fontColor=#18334B;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
