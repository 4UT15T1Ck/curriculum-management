generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum OrgUnitType {
  UNIVERSITY
  FACULTY
  OFFICE
}

enum OrgUnitStatus {
  ACTIVE
  INACTIVE
}

enum SubjectGroupStatus {
  ACTIVE
  INACTIVE
}

enum SubjectGroupMemberRole {
  MEMBER
  COORDINATOR
}

enum CourseType {
  THEORY
  PRACTICE
  LAB
  PROJECT
  CAPSTONE
  INTERNSHIP
  CONDITIONAL
}

enum CourseStatus {
  ACTIVE
  DISCONTINUED
  CANCELLED
}

enum DegreeLevel {
  ENGINEER
  BACHELOR
}

enum ProgramStatus {
  ACTIVE
  INACTIVE
}

enum ProgramVersionStatus {
  DRAFT
  PENDING
  ACTIVE
  HISTORICAL
}

enum ScopeSource {
  NONE
  PROGRAM_DIRECTOR
  SUBJECT_GROUP_COORDINATOR
  SUBJECT_GROUP_MEMBER
  OWN_ENROLLMENT
}

enum FunctionGroup {
  SYSTEM_ADMIN
  COURSE_CATALOG
  PROGRAM
  LEARNING_OUTCOME
  SYLLABUS
  APPROVAL
  VERSION
  DATA_REPORT
  STUDENT_LOOKUP
}

enum PermissionMode {
  DIRECT
  VIA_REQUEST
}

enum PermissionScope {
  ALL
  SCOPED
}

enum ScopeType {
  SYSTEM
  UNIT
  ASSIGNMENT
}

model OrgUnit {
  id              String           @id @default(cuid(2))
  unitCode        String           @unique
  unitName        String
  unitType        OrgUnitType
  parentUnitId    String?
  parentUnit      OrgUnit?         @relation("OrgUnitTree", fields: [parentUnitId], references: [id], onDelete: Restrict)
  childUnits      OrgUnit[]        @relation("OrgUnitTree")
  status          OrgUnitStatus    @default(ACTIVE)
  users           User[]
  roleAssignments RoleAssignment[]
  subjectGroups   SubjectGroup[]
  ownedCourses    Course[]         @relation("CourseOwnerFaculty")
  programs        Program[]        @relation("ProgramFaculty")
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([parentUnitId])
}

model User {
  id                        String                      @id @default(cuid(2))
  userCode                  String                      @unique
  fullName                  String
  email                     String?
  status                    UserStatus                  @default(ACTIVE)
  username                  String                      @unique
  passwordHash              String
  mustChangePassword        Boolean                     @default(false)
  orgUnitId                 String?
  orgUnit                   OrgUnit?                    @relation(fields: [orgUnitId], references: [id], onDelete: Restrict)
  roleAssignments           RoleAssignment[]            @relation("AssignmentHolder")
  grantedAssignments        RoleAssignment[]            @relation("AssignmentGrantor")
  revokedAssignments        RoleAssignment[]            @relation("AssignmentRevoker")
  subjectGroupMemberships   SubjectGroupMember[]        @relation("MembershipHolder")
  grantedMemberships        SubjectGroupMember[]        @relation("MembershipGrantor")
  revokedMemberships        SubjectGroupMember[]        @relation("MembershipRevoker")
  updatedRolePermissions    RolePermission[]
  programDirectorships      ProgramDirectorAssignment[] @relation("ProgramDirector")
  grantedDirectorships      ProgramDirectorAssignment[] @relation("ProgramDirectorAssignedBy")
  revokedDirectorships      ProgramDirectorAssignment[] @relation("ProgramDirectorRevokedBy")
  creditMismatchAcceptances ProgramVersion[]            @relation("CreditMismatchAcceptedBy")
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt

  @@index([orgUnitId])
}

model SubjectGroup {
  id           String               @id @default(cuid(2))
  groupCode    String               @unique
  groupName    String
  facultyId    String
  faculty      OrgUnit              @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  status       SubjectGroupStatus   @default(ACTIVE)
  members      SubjectGroupMember[]
  ownedCourses Course[]             @relation("CourseOwnerGroup")
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([facultyId])
}

model Course {
  id                   String                 @id @default(cuid(2))
  courseCode           String                 @unique
  courseName           String
  englishName          String?
  credits              Decimal                @db.Decimal(5, 2)
  courseType           CourseType
  status               CourseStatus           @default(ACTIVE)
  ownerFacultyId       String
  ownerFaculty         OrgUnit                @relation("CourseOwnerFaculty", fields: [ownerFacultyId], references: [id], onDelete: Restrict)
  ownerGroupId         String?
  ownerGroup           SubjectGroup?          @relation("CourseOwnerGroup", fields: [ownerGroupId], references: [id], onDelete: Restrict)
  equivalenceGroupId   String?
  equivalenceGroup     EquivalentCourseGroup? @relation("CourseEquivalence", fields: [equivalenceGroupId], references: [id], onDelete: SetNull)
  relationsAsSource    CourseRelation[]       @relation("RelationSource")
  relationsAsTarget    CourseRelation[]       @relation("RelationTarget")
  curriculumItems      CurriculumItem[]       @relation("CurriculumItemCourse")
  curriculumRequisites CurriculumRequisite[]  @relation("CurriculumRequisiteSource")
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([ownerFacultyId])
  @@index([ownerGroupId])
  @@index([courseName])
  @@index([equivalenceGroupId])
}

enum CourseRelationType {
  PRIOR
  PREREQUISITE
  COREQUISITE
  REPLACEMENT
}

// sourceCourse = the course studied first (or the discontinued one); targetCourse = the course that has the requirement.
// Two CHECK constraints are added by hand in the migration (not modelled by Prisma): see database_and_models.md.
model CourseRelation {
  id             String             @id @default(cuid(2))
  sourceCourseId String
  sourceCourse   Course             @relation("RelationSource", fields: [sourceCourseId], references: [id], onDelete: Restrict)
  targetCourseId String
  targetCourse   Course             @relation("RelationTarget", fields: [targetCourseId], references: [id], onDelete: Restrict)
  relationType   CourseRelationType
  minScore       Decimal?           @db.Decimal(4, 2)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([sourceCourseId, targetCourseId, relationType])
  @@index([targetCourseId])
}

model EquivalentCourseGroup {
  id        String   @id @default(cuid(2))
  groupCode String   @unique
  note      String?
  members   Course[] @relation("CourseEquivalence")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SubjectGroupMember {
  id             String                 @id @default(cuid(2))
  subjectGroupId String
  subjectGroup   SubjectGroup           @relation(fields: [subjectGroupId], references: [id], onDelete: Restrict)
  lecturerId     String
  lecturer       User                   @relation("MembershipHolder", fields: [lecturerId], references: [id], onDelete: Restrict)
  memberRole     SubjectGroupMemberRole
  validFrom      DateTime               @db.Date
  validTo        DateTime?              @db.Date
  assignedById   String?
  assignedBy     User?                  @relation("MembershipGrantor", fields: [assignedById], references: [id], onDelete: Restrict)
  revokedAt      DateTime?
  revokedById    String?
  revokedBy      User?                  @relation("MembershipRevoker", fields: [revokedById], references: [id], onDelete: Restrict)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([lecturerId])
  @@index([subjectGroupId])
}

model Program {
  id           String                      @id @default(cuid(2))
  programCode  String                      @unique
  facultyId    String
  faculty      OrgUnit                     @relation("ProgramFaculty", fields: [facultyId], references: [id], onDelete: Restrict)
  degreeLevel  DegreeLevel
  status       ProgramStatus               @default(ACTIVE)
  clonedFromId String?
  clonedFrom   ProgramVersion?             @relation("ProgramClonedFrom", fields: [clonedFromId], references: [id], onDelete: Restrict)
  versions     ProgramVersion[]            @relation("ProgramVersions")
  directors    ProgramDirectorAssignment[]
  createdAt    DateTime                    @default(now())
  updatedAt    DateTime                    @updatedAt

  @@index([facultyId])
}

// Identity lives in Program; the description (name, major, semesters, credits) lives here so a released version keeps its own (M-3).
// Two partial unique indexes are added by hand in the migration (not modelled by Prisma): see database_and_models.md.
model ProgramVersion {
  id                          String               @id @default(cuid(2))
  programId                   String
  program                     Program              @relation("ProgramVersions", fields: [programId], references: [id], onDelete: Restrict)
  versionNumber               String?
  status                      ProgramVersionStatus @default(DRAFT)
  programName                 String
  majorCode                   String
  majorName                   String
  semesterCount               Int
  totalCredits                Decimal              @db.Decimal(5, 2)
  compulsoryCredits           Decimal              @db.Decimal(5, 2)
  electiveCredits             Decimal              @db.Decimal(5, 2)
  creditMismatchReason        String?
  creditMismatchCompulsoryGap Decimal?             @db.Decimal(5, 2)
  creditMismatchElectiveGap   Decimal?             @db.Decimal(5, 2)
  creditMismatchAcceptedById  String?
  creditMismatchAcceptedBy    User?                @relation("CreditMismatchAcceptedBy", fields: [creditMismatchAcceptedById], references: [id], onDelete: Restrict)
  creditMismatchAcceptedAt    DateTime?
  clones                      Program[]            @relation("ProgramClonedFrom")
  electiveGroups              ElectiveGroup[]
  curriculumItems             CurriculumItem[]
  createdAt                   DateTime             @default(now())
  updatedAt                   DateTime             @updatedAt

  @@unique([programId, versionNumber])
  @@index([programId, status])
}

model ProgramDirectorAssignment {
  id           String    @id @default(cuid(2))
  programId    String
  program      Program   @relation(fields: [programId], references: [id], onDelete: Restrict)
  directorId   String
  director     User      @relation("ProgramDirector", fields: [directorId], references: [id], onDelete: Restrict)
  validFrom    DateTime  @db.Date
  validTo      DateTime? @db.Date
  assignedById String?
  assignedBy   User?     @relation("ProgramDirectorAssignedBy", fields: [assignedById], references: [id], onDelete: Restrict)
  revokedAt    DateTime?
  revokedById  String?
  revokedBy    User?     @relation("ProgramDirectorRevokedBy", fields: [revokedById], references: [id], onDelete: Restrict)
  createdAt    DateTime  @default(now())

  @@index([directorId])
  @@index([programId])
}

model Role {
  id              String           @id @default(cuid(2))
  roleCode        String           @unique
  roleName        String
  description     String?
  isSystemRole    Boolean          @default(false)
  scopeSource     ScopeSource      @default(NONE)
  rolePermissions RolePermission[]
  assignments     RoleAssignment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Permission {
  id              String           @id @default(cuid(2))
  permissionCode  String           @unique
  permissionName  String
  functionGroup   FunctionGroup
  description     String?
  source          String?
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model RolePermission {
  id           String          @id @default(cuid(2))
  roleId       String
  role         Role            @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permissionId String
  permission   Permission      @relation(fields: [permissionId], references: [id], onDelete: Restrict)
  mode         PermissionMode
  scope        PermissionScope
  updatedById  String?
  updatedBy    User?           @relation(fields: [updatedById], references: [id], onDelete: Restrict)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@unique([roleId, permissionId])
  @@index([permissionId])
}

model RoleAssignment {
  id           String    @id @default(cuid(2))
  userId       String
  user         User      @relation("AssignmentHolder", fields: [userId], references: [id], onDelete: Restrict)
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  scopeType    ScopeType
  scopeUnitId  String?
  scopeUnit    OrgUnit?  @relation(fields: [scopeUnitId], references: [id], onDelete: Restrict)
  validFrom    DateTime  @db.Date
  validTo      DateTime? @db.Date
  assignedById String?
  assignedBy   User?     @relation("AssignmentGrantor", fields: [assignedById], references: [id], onDelete: Restrict)
  revokedAt    DateTime?
  revokedById  String?
  revokedBy    User?     @relation("AssignmentRevoker", fields: [revokedById], references: [id], onDelete: Restrict)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([userId, roleId, scopeUnitId, validFrom])
  @@index([userId])
}

model Session {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
  @@map("session")
}

// Global list of knowledge blocks; a row's free-text blockSymbol is matched to blockCode when one exists, not enforced (F07-02).
model KnowledgeBlock {
  id              String   @id @default(cuid(2))
  blockCode       String   @unique
  blockName       String
  requiredCredits Decimal? @db.Decimal(5, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// With both minimums set, a student must meet both. Deleting a group leaves its rows elective with no group.
// A CHECK (at least one minimum) is added by hand in the migration: see database_and_models.md.
model ElectiveGroup {
  id         String           @id @default(cuid(2))
  versionId  String
  version    ProgramVersion   @relation(fields: [versionId], references: [id], onDelete: Cascade)
  groupCode  String
  groupName  String
  minCredits Decimal?         @db.Decimal(5, 2)
  minCourses Int?
  items      CurriculumItem[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([versionId, groupCode])
}

// sortOrder orders rows inside one semester; the "TT" number is derived. Credits and names are read live from Course until F-15 snapshots them.
// Five CHECK constraints are added by hand in the migration (not modelled by Prisma): see database_and_models.md.
model CurriculumItem {
  id               String                @id @default(cuid(2))
  versionId        String
  version          ProgramVersion        @relation(fields: [versionId], references: [id], onDelete: Cascade)
  plannedSemester  Int
  sortOrder        Int
  courseId         String
  course           Course                @relation("CurriculumItemCourse", fields: [courseId], references: [id], onDelete: Restrict)
  blockSymbol      String?
  isElective       Boolean
  electiveGroupId  String?
  electiveGroup    ElectiveGroup?        @relation(fields: [electiveGroupId], references: [id], onDelete: SetNull)
  htDa             Boolean               @default(false)
  tqDa             Boolean               @default(false)
  minStudiedScore  Decimal?              @db.Decimal(4, 2)
  minTransferScore Decimal?              @db.Decimal(4, 2)
  note             String?
  requisites       CurriculumRequisite[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@unique([versionId, courseId])
  @@index([versionId, plannedSemester, sortOrder])
  @@index([courseId])
  @@index([electiveGroupId])
}

// Per-curriculum requisites, seeded from CourseRelation when the row is added and edited for this curriculum only.
model CurriculumRequisite {
  id             String             @id @default(cuid(2))
  itemId         String
  item           CurriculumItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  sourceCourseId String
  sourceCourse   Course             @relation("CurriculumRequisiteSource", fields: [sourceCourseId], references: [id], onDelete: Restrict)
  relationType   CourseRelationType
  minScore       Decimal?           @db.Decimal(4, 2)
  createdAt      DateTime           @default(now())

  @@unique([itemId, sourceCourseId, relationType])
  @@index([sourceCourseId])
}
