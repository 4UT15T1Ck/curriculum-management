{
  "permissions": {
    "deny": [
      "Read(./**/node_modules/**)",
      "Read(./**/dist/**)",
      "Read(./**/build/**)",
      "Read(./**/coverage/**)",
      "Read(./**/logs/**)",
      "Read(./**/*.log)",
      "Read(./**/.cache/**)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.jks)"
    ]
  },
  "env": {
    "ENABLE_TOOL_SEARCH": "true"
  }
}
